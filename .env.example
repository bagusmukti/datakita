# DataKita Environment Variables
# Copy this file to .env and fill in the values

# CORS Proxy — used as fallback for BMKG API (which may block browser requests)
VITE_CORS_PROXY=https://corsproxy.io/?

# API Base URLs (defaults shown, only override if needed)
VITE_BMKG_BASE=https://data.bmkg.go.id
VITE_BMKG_WEATHER_BASE=https://api.bmkg.go.id
VITE_WORLDBANK_BASE=https://api.worldbank.org/v2
VITE_DISEASE_BASE=https://disease.sh/v3/covid-19
